<%- include('header', { title: 'Dashboard' }) %>
<%
  const sumRows = (rows) => Object.values(rows).reduce((a, r) => ({ income: a.income + r.income, expense: a.expense + r.expense }), { income: 0, expense: 0 });
  const tAll = sumRows(todayRows), mAll = sumRows(monthRows);
  const dates = [...new Set(daily.map(d => d.date))];
  const dayTotal = dates.map(dt => daily.filter(d => d.date === dt).reduce((s, r) => s + r.income, 0));
  const closedDays = days.filter(d => d.status === 'closed');
  const matched = closedDays.filter(d => d.counted_cash === d.expected_cash).length;
  const accuracy = closedDays.length ? matched / closedDays.length * 100 : 0;
  const margin = mAll.income ? (mAll.income - mAll.expense) / mAll.income * 100 : 0;
  const shortTotal = closedDays.reduce((s, d) => s + Math.max(0, d.expected_cash - d.counted_cash), 0);
  const topIncome = topCats.filter(c => c.type === 'income').slice(0, 6);
  const maxCat = Math.max(1, ...topIncome.map(c => c.total));
%>
<div class="hero">
  <div>
    <div><p class="eyebrow">Both branches · <%= today %> · Pakistan time</p><h1>Cash<br>Summary</h1></div>
    <div class="card">
      <div class="ph"><h2>Today</h2><span class="dot"></span></div>
      <% branches.forEach(b => { const r = todayRows[b.id] || { income: 0, expense: 0 }; const d = days.find(x => x.branch_id === b.id && x.date === today); %>
        <div class="kv"><span><a href="/day/<%= b.id %>/<%= today %>"><%= b.name.split(' ')[0] %></a> · <%= b.business %> <span class="badge <%= d && d.status === 'closed' ? 'closed' : 'open' %>"><%= d ? d.status : 'not started' %></span></span><b><%= rs(r.income - r.expense) %></b></div>
      <% }) %>
      <div class="kv"><span>Income</span><b class="good"><%= rs(tAll.income) %></b></div>
      <div class="kv"><span>Expenses</span><b class="bad"><%= rs(tAll.expense) %></b></div>
      <div class="kv"><span>Net today</span><b style="font-size:1.3em"><%= rs(tAll.income - tAll.expense) %></b></div>
    </div>
  </div>
  <div class="grid2 gauges" style="margin:0">
    <div class="card">
      <div class="ph"><h2>Cash Accuracy</h2><span class="dot"></span></div>
      <div class="mini"><span><b><%= matched %></b>Days matched</span><span><b><%= closedDays.length - matched %></b>Mismatched</span></div>
      <div class="gauge"><%- gaugeSvg(accuracy) %><div class="val"><span><%= Math.round(accuracy) %><small>%</small></span></div></div>
      <p class="muted small" style="text-align:center;margin:6px 0 0">Closed days in the last 30 where counted cash matched</p>
    </div>
    <div class="card">
      <div class="ph"><h2>Profit Margin</h2><span class="dot"></span></div>
      <div class="mini"><span><b><%= short(mAll.income) %></b>Income</span><span><b><%= short(mAll.expense) %></b>Expense</span></div>
      <div class="gauge"><%- gaugeSvg(margin) %><div class="val"><span><%= Math.round(margin) %><small>%</small></span></div></div>
      <p class="muted small" style="text-align:center;margin:6px 0 0">Net as a share of income, <%= month %></p>
    </div>
    <div class="card alertcard" style="grid-column:1/-1">
      <div class="ph"><h2>Needs Attention</h2><span class="badge"><%= mismatches.length + bigExpenses.length + alerts.length %></span></div>
      <% if (!mismatches.length && !bigExpenses.length && !alerts.length) { %><p class="muted" style="margin:0">All clear. Nothing unusual in the last 30 days.</p><% } %>
      <ul>
      <% mismatches.slice(0, 5).forEach(d => { const diff = d.counted_cash - d.expected_cash; %>
        <li><a href="/day/<%= d.branch_id %>/<%= d.date %>"><%= d.date %> · <%= branchName(d.branch_id).split(' ')[0] %></a> cash <b><%= diff < 0 ? 'short' : 'excess' %> <%= rs(Math.abs(diff)) %></b></li><% }) %>
      <% bigExpenses.slice(0, 5).forEach(e => { %>
        <li><a href="/day/<%= e.branch_id %>/<%= e.date %>"><%= e.date %> · <%= branchName(e.branch_id).split(' ')[0] %></a> big expense <b><%= rs(e.amount) %></b> (<%= e.category %>)</li><% }) %>
      </ul>
      <% if (alerts.length) { %><div class="tablewrap"><table><% alerts.slice(0, 6).forEach(a => { %><%- include('auditrow', { a }) %><% }) %></table></div><% } %>
    </div>
  </div>
</div>

<div class="grid2">
  <div class="card">
    <div class="ph"><h2>Daily Income</h2><span class="badge">Last 30 days</span></div>
    <div class="row between" style="align-items:end"><div class="big"><%= rs(dayTotal.reduce((a, b) => a + b, 0)) %></div>
      <div class="legend"><span><i style="background:var(--accent)"></i>Top 3 days</span><span><i style="background:var(--faint)"></i>Other days</span></div></div>
    <%- columnsSvg(dayTotal, dates) %>
    <div class="foot"><div><%= short(mAll.income) %><small>Income</small></div><div><%= short(mAll.expense) %><small>Expenses</small></div><div><%= short(mAll.income - mAll.expense) %><small>Net</small></div><div class="bad"><%= rs(shortTotal) %><small>Short</small></div></div>
  </div>
  <div class="card">
    <div class="ph"><h2>Branches</h2><span class="badge"><%= month %></span></div>
    <% branches.forEach(b => { const m = monthRows[b.id] || { income: 0, expense: 0 }; %>
      <div style="margin-bottom:18px"><div class="row between"><b style="font-weight:500"><%= b.name %></b><span class="muted small"><%= b.business %></span></div>
      <div class="kv"><span>Income</span><b class="good"><%= rs(m.income) %></b></div><div class="kv"><span>Expenses</span><b class="bad"><%= rs(m.expense) %></b></div>
      <div class="kv"><span>Net</span><b><%= rs(m.income - m.expense) %></b></div></div>
    <% }) %>
    <h2 style="margin-top:6px">Top services</h2>
    <% topIncome.forEach(c => { %><div class="row between small"><span><%= c.category %> <span class="muted">· <%= branchName(c.branch_id).split(' ')[0] %></span></span><b style="font-weight:500"><%= rs(c.total) %></b></div>
      <div class="hbar"><div class="inc" style="width:<%= (c.total / maxCat * 100).toFixed(1) %>%"></div></div><% }) %>
    <% if (!topIncome.length) { %><p class="muted">No income this month yet.</p><% } %>
  </div>
</div>

<div class="card"><div class="ph"><h2>Daily Summary</h2><span class="badge">30 days</span></div><div class="tablewrap"><table>
  <tr><th>Date</th><th>Branch</th><th class="r">Income</th><th class="r">Expense</th><th class="r">Net</th><th>Cash</th></tr>
  <% [...daily].reverse().slice(0, 20).forEach(r => { const d = days.find(x => x.branch_id === r.branch_id && x.date === r.date); const diff = d && d.status === 'closed' ? d.counted_cash - d.expected_cash : null; %>
  <tr><td><a href="/day/<%= r.branch_id %>/<%= r.date %>"><%= r.date %></a></td><td><%= branchName(r.branch_id).split(' ')[0] %></td>
    <td class="r"><%= rs(r.income) %></td><td class="r"><%= rs(r.expense) %></td><td class="r"><b style="font-weight:500"><%= rs(r.income - r.expense) %></b></td>
    <td class="<%= diff === null ? 'muted' : (diff === 0 ? 'good' : 'bad') %>"><%= diff === null ? (d ? d.status : '') : (diff === 0 ? 'OK' : (diff < 0 ? 'short ' : 'excess ') + rs(Math.abs(diff))) %></td></tr><% }) %>
  <% if (!daily.length) { %><tr><td colspan="6" class="muted">No entries yet.</td></tr><% } %>
</table></div></div>

<div class="card"><div class="ph"><h2>Latest Activity</h2><a href="/owner/audit">Full activity log →</a></div>
<div class="tablewrap"><table><tr><th>When</th><th>Who</th><th>Branch</th><th>What</th><th>Details</th></tr>
<% feed.forEach(a => { %><%- include('auditrow', { a }) %><% }) %></table></div></div>
<%- include('footer') %>
