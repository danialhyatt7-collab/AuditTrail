<%- include('header', { title: 'Password' }) %>
<div class="card narrow"><h2>Change password</h2>
<form method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Current password <input type="password" name="current" required></label>
  <label>New password (6+ characters) <input type="password" name="next" minlength="6" required></label>
  <button>Save</button></form></div>
<%- include('footer') %>
