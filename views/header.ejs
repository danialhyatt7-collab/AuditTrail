<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>AuditTrail</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600&display=swap">
<link rel="stylesheet" href="/style.css"></head>
<body>
<% if (user) { %>
<header class="top">
  <a class="brand" href="/"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="#f4f3ea" stroke-width="2.5" stroke-dasharray="62 20"/><path d="M10 17l4 4 8-9" fill="none" stroke="#f4f3ea" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>AuditTrail</a>
  <nav>
    <% if (user.role === 'owner') { %>
      <% const nav = (h, t) => `<a href="${h}" class="${path === h ? 'on' : ''}">${t}</a>`; %>
      <%- nav('/owner','Dashboard') %><%- nav('/owner/entries','Entries') %><%- nav('/owner/audit','Activity log') %><%- nav('/owner/users','Team') %>
    <% } else { %><a href="/" class="on">Today</a><% } %>
    <a href="/password">Password</a>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Logout (<%= user.name %>)</button></form>
  </nav>
</header>
<% } %>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
